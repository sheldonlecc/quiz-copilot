{
  "manifest_version": 3,
  "name": "答题助手 QuizCopilot",
  "version": "1.19.2",
  "description": "自动读取网页上的题目（单选/多选/判断/填空/表格/匹配/论述），调用 AI 给出答案与解析；点右下角小机器人一键读完并填入。还能连续翻页做题、划词解释、番茄钟和任务统计；小机器人会换表情、换装、结蜘蛛网、跟你说话。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "答题助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/00-core.js",
        "content/10-icon.js",
        "content/10-choice.js",
        "content/15-text.js",
        "content/20-blank.js",
        "content/30-match.js",
        "content/40-extract.js",
        "content/45-solve.js",
        "content/50-answer.js",
        "content/60-css.js",
        "content/70-panel.js",
        "content/80-mascot.js",
        "content/81-lines.js",
        "content/82-chat.js",
        "content/84-wardrobe.js",
        "content/85-menu.js",
        "content/86-pomo.js",
        "content/87-selection.js",
        "content/88-chain.js",
        "content/89-pomowin.js",
        "content/90-main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "打开 / 收起答题面板"
    },
    "one-key-solve": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "一键解题：读题 → 作答 → 全部填入页面"
    }
  }
}
